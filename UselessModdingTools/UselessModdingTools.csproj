<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <PropertyGroup>
        <ILSpyFolder>$(MSBuildProjectDirectory)\..\..\ILSpy\ILSpy\bin\</ILSpyFolder>
        <ILSpyTargetFramework>net10.0\</ILSpyTargetFramework>
        <ILSpyDebug>$(ILSpyFolder)Debug\$(ILSpyTargetFramework)</ILSpyDebug>
        <ILSpyRelease>$(ILSpyFolder)Release\$(ILSpyTargetFramework)</ILSpyRelease>
    </PropertyGroup>

    <Target Name="CopyToILSpy" AfterTargets="PostBuildEvent">
        <Message Text="Copying .dll to ILSpy folder $(ILSpyDebug)." Importance="high" />
        <ItemGroup>
            <_Files Include="$(TargetPath)" />
            <_Files Include="$(TargetDir)$(TargetName).pdb" Condition="'$(Configuration)' == 'Debug'" />
        </ItemGroup>
        <Copy SourceFiles="@(_Files)" DestinationFolder="$(ILSpyDebug)" Condition="'$(Configuration)' == 'Debug'" />
        <Copy SourceFiles="@(_Files)" DestinationFolder="$(ILSpyRelease)" Condition="'$(Configuration)' == 'Release'" />
    </Target>

</Project>
